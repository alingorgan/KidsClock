{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(~/Library/Android/sdk/platform-tools/adb:*)",
      "Bash(~/Library/Android/sdk/emulator/emulator:*)",
      "Bash(~/Library/Android/sdk/cmdline-tools/latest/bin/sdkmanager:*)",
      "Bash(~/Library/Android/sdk/cmdline-tools/latest/bin/avdmanager:*)",
      "Bash(adb:*)",
      "Bash(emulator:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-changed.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
