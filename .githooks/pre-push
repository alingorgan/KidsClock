#!/usr/bin/env bash
# Git pre-push: the full gate (ktlint, Android lint, all tests, snapshots, guardrails).
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "Running ./gradlew check before push..." >&2
if ! out=$(./gradlew check --console=plain -q 2>&1); then
  echo "$out" | tail -60 >&2
  echo "./gradlew check failed; push blocked." >&2
  exit 1
fi
